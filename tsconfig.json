{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": ".",
    "outDir": "./dist",
    "module": "commonjs",
    "target": "es2016",
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs may remove as it increases build size
    // "sourceMap": true,
    // "declaration": true,
    // "declarationMap": true,
    "esModuleInterop":true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
  },
  "include": ["src/**/*","api/**/*", "api"],
  "exclude": ["node_modules"]
}
